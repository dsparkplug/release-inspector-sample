<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- The product name and version go into the file's version information, which Release Inspector reads. The
		     workflow sets the version from the run number, so each release is newer than the last. -->
		<Product>HelloRelease</Product>
		<Company>Release Inspector sample</Company>
		<Version>1.0.0</Version>
	</PropertyGroup>

</Project>
